{
  "name": "commiledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node --import tsx scripts/prerender.ts",
    "build:api": "wrangler deploy --dry-run --outdir dist-api",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "dev:api": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply commiledger --local",
    "db:migrate:remote": "wrangler d1 migrations apply commiledger --remote",
    "deploy": "npm run build && wrangler deploy",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@paddle/paddle-node-sdk": "^3.4.0",
    "better-auth": "^1.7.27",
    "decimal.js": "^10.6.0",
    "fflate": "^0.8.2",
    "hono": "^4.10.6",
    "lucide-react": "^0.468.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "read-excel-file": "^6.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261121.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "axe-core": "^4.11.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^27.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^5.1.1",
    "wrangler": "^4.50.0"
  }
}
